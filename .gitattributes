# Keep Unity text assets stable across machines.
* text=auto

*.shader text eol=lf
*.cginc text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.mat text eol=lf
*.prefab text eol=lf
*.meta text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.unity3d binary
*.zip binary
*.zipmod binary
